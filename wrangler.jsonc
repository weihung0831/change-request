{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "change-request",
	"compatibility_date": "2026-09-01",
	"workers_dev": false,
	"routes": [{ "pattern": "change-request.weihung.xyz", "custom_domain": true }],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "change-request-db",
			"database_id": "0b19120e-5e32-474c-8d92-382795513828",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "change-request-images"
		}
	],
	"observability": {
		"enabled": true
	}
}
